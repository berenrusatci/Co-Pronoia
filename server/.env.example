DATABASE_URL="postgresql://treemapper:treemapper@localhost:5433/treemapper?schema=public"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/api/auth/google/callback"

# Kayıt e-posta doğrulaması (Google dışı kayıtlar için) — SMTP ayarları.
# Boş bırakılırsa: geliştirmede kod sunucu konsoluna yazılır; production'da (NODE_ENV=production) kayıt 503 döner.
# Gmail için: 2FA açık olmalı + https://myaccount.google.com/apppasswords adresinden uygulama şifresi.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="co-pronoia <no-reply@example.com>"

# Ters proxy (Render, nginx, Cloudflare…) arkasında mısınız? "1"/"true" ile açın.
# Açıkken Fastify `X-Forwarded-For` başlığına güvenir ve `req.ip` gerçek istemciyi gösterir;
# giriş/doğrulama postası oran sınırlarının IP kovaları YALNIZ bu açıkken işletilir.
# Proxy arkasında değilken açmayın: istemci kendi IP'sini uydurup sınırı atlatabilir.
TRUST_PROXY=""

# Oturum çerezine `Secure` ekleme kararı. Boş bırakılırsa NODE_ENV=production'da açık,
# geliştirmede (http://localhost) kapalıdır. HTTPS sonlandırmayan bir vekilin arkasında
# çalışıyorsanız "0" ile kapatabilirsiniz.
SESSION_COOKIE_SECURE=""

# Yerleşik Gemini ajanının tek çağrı üst süre sınırı (ms). Varsayılan 60000.
GEMINI_TIMEOUT_MS=""

# Yerel kurulumun buluta yaptığı çağrıların üst süre sınırı (ms). Varsayılan 20000 / export 60000.
CLOUD_TIMEOUT_MS=""
CLOUD_EXPORT_TIMEOUT_MS=""

# BULUT TARAFI: aktivasyon onayının kabul ettiği ek dönüş hostları (virgülle ayrılmış).
# Öntanımlı olarak yalnız loopback / RFC1918 / *.local adresleri kabul edilir — yerel
# kurulum tanımı gereği yerel ağdadır ve serbest bir dönüş adresi tek tıkla hesap devri
# demektir. Kendi alan adı üzerinden eriştiğiniz bir kurulum varsa buraya ekleyin.
CLOUD_ALLOWED_LOCAL_HOSTS=""

# Site yönetim paneli hesabı: sunucu açılışında idempotent oluşturulur/terfi ettirilir.
# Kullanıcı zaten varsa yalnızca yönetici yapılır, şifresi değiştirilmez. Boş bırakılırsa atlanır.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
