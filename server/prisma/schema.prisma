generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String?        @unique
  passwordHash String?
  googleId     String?        @unique
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  sessions     Session[]
  commits      Commit[]
  branches     Branch[]
  ownedCanvases Canvas[]
  memberships  CanvasMember[]
  invites      Invite[]
  regionMemberships RegionMember[]
  groupMemberships GroupMember[]
  groupInvitesCreated GroupInvite[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Canvas {
  id        String         @id @default(cuid())
  name      String
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id])
  groupId   String?
  group     Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  members   CanvasMember[]
  invites   Invite[]
  nodes     Node[]
  edges     Edge[]
  commits   Commit[]
  branches  Branch[]
  regions   Region[]
  roleAccess CanvasRoleAccess[]
}

model Group {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())
  members   GroupMember[]
  canvases  Canvas[]
  invites   GroupInvite[]
  roleDefs  GroupRoleDef[]
}

/// Grup kurucusunun tanımladığı özel rol: isim + yetki bayrakları.
/// Kanvas ve bölge erişimleri bu role ayrı tablolarla (CanvasRoleAccess / RegionRoleAccess) bağlanır.
model GroupRoleDef {
  id                  String   @id @default(cuid())
  groupId             String
  group               Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name                String
  canManageMembers    Boolean  @default(false)
  canManageRoles      Boolean  @default(false)
  canCreateCanvas     Boolean  @default(true)
  /// Açık CanvasRoleAccess kaydı olmayan grup kanvasları için geçerli erişim: none | view | edit
  defaultCanvasAccess String   @default("edit")
  createdAt           DateTime @default(now())
  members             GroupMember[]
  canvasAccess        CanvasRoleAccess[]
  regionAccess        RegionRoleAccess[]

  @@index([groupId])
}

model GroupMember {
  groupId     String
  group       Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String        @default("member")
  status      String        @default("pending")
  jobTitle    String?
  roleDefId   String?
  roleDef     GroupRoleDef? @relation(fields: [roleDefId], references: [id], onDelete: SetNull)
  requestedAt DateTime      @default(now())

  @@id([groupId, userId])
}

/// Rolün belirli bir grup kanvasına erişimi: none | view | edit.
model CanvasRoleAccess {
  canvasId String
  canvas   Canvas       @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  roleId   String
  role     GroupRoleDef @relation(fields: [roleId], references: [id], onDelete: Cascade)
  access   String

  @@id([canvasId, roleId])
}

/// Rolün bölge üyeliği: kaydı olan rol o bölgedeki düğümlere dokunabilir.
model RegionRoleAccess {
  regionId String
  region   Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  roleId   String
  role     GroupRoleDef @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([regionId, roleId])
}

model GroupInvite {
  token     String   @id
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
}

model CanvasMember {
  canvasId String
  canvas   Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("editor")
  joinedAt DateTime @default(now())

  @@id([canvasId, userId])
}

model Region {
  id        String         @id @default(cuid())
  canvasId  String
  canvas    Canvas         @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  name      String
  x         Float
  y         Float
  width     Float
  height    Float
  color     String         @default("#d97757")
  createdAt DateTime       @default(now())
  members   RegionMember[]
  roleAccess RegionRoleAccess[]

  @@index([canvasId])
}

model RegionMember {
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([regionId, userId])
}

model Invite {
  token     String   @id
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
}

model Node {
  canvasId      String
  canvas        Canvas  @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  id            String
  parentId      String?
  title         String
  description   String  @default("")
  nodeType      String  @default("task")
  status        String  @default("planned")
  x             Float?
  y             Float?
  createdCommit Int
  updatedCommit Int

  @@id([canvasId, id])
}

model Edge {
  canvasId      String
  canvas        Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  id            String
  sourceId      String
  targetId      String
  kind          String @default("flow")
  direction     String @default("directed")
  label         String @default("")
  createdCommit Int

  @@id([canvasId, id])
}

model Commit {
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  seq       Int
  message   String
  createdAt DateTime @default(now())
  ops       String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@id([canvasId, seq])
  @@index([canvasId, branchId, seq])
}

model Branch {
  id        String   @id @default(cuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  name      String
  baseSeq   Int
  status    String   @default("open")
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  commits   Commit[]

  @@index([canvasId, status])
}
