generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String?        @unique
  passwordHash String?
  googleId     String?        @unique
  displayName  String?
  avatarUrl    String?
  /// Site geneli yönetici: /api/admin/* uçlarına erişir. Kanvas/grup rollerinden bağımsızdır.
  isAdmin      Boolean        @default(false)
  createdAt    DateTime       @default(now())
  sessions     Session[]
  commits      Commit[]
  branches     Branch[]
  ownedCanvases Canvas[]
  memberships  CanvasMember[]
  invites      Invite[]
  regionMemberships RegionMember[]
  groupMemberships GroupMember[]
  groupInvitesCreated GroupInvite[]
  agentTokens  AgentToken[]
  instances    Instance[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

/// Kayıt sırasında e-posta doğrulaması bekleyen (henüz User olmayan) kayıtlar.
/// Kod doğrulanınca buradaki alanlardan gerçek User oluşturulur ve satır silinir.
model EmailVerification {
  email        String   @id
  username     String
  passwordHash String
  displayName  String?
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
}

model Canvas {
  id        String         @id @default(cuid())
  name      String
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id])
  groupId   String?
  group     Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// 'plan' (normal) | 'co-pronoia' (MCP ajan önerileriyle planlama). Kodda doğrulanır, enum değil.
  type      String         @default("plan")
  createdAt DateTime       @default(now())
  members   CanvasMember[]
  invites   Invite[]
  nodes     Node[]
  edges     Edge[]
  commits   Commit[]
  branches  Branch[]
  regions   Region[]
  roleAccess CanvasRoleAccess[]
  agentTokens AgentToken[]
  proposals PlanProposal[]
  briefRevisions CanvasBriefRevision[]
  nodeClaims NodeClaim[]
}

/// Kanvasın serbest brifing dokümanı ("kanvasın CLAUDE.md'si"). Bölgeler gibi kanvas AYARIDIR,
/// event-sourced graf verisi değildir — commit/rebuildCheck hattına girmez. Güncel içerik = en
/// büyük id'li revizyon; her yazma yeni satır ekler (hafif değişiklik geçmişi, append-only).
model CanvasBriefRevision {
  id          Int      @id @default(autoincrement())
  canvasId    String
  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  content     String
  /// İnsan yazarında kullanıcı adı, ajan yazarında "label/roleName".
  authorLabel String
  createdAt   DateTime @default(now())

  @@index([canvasId, id])
}

model Group {
  id        String         @id @default(cuid())
  name      String
  /// 'plan' | 'co-pronoia' — co-pronoia kanvası yalnızca co-pronoia grubunda açılabilir.
  type      String         @default("plan")
  createdAt DateTime       @default(now())
  members   GroupMember[]
  canvases  Canvas[]
  invites   GroupInvite[]
  roleDefs  GroupRoleDef[]
  agentRoles AgentRoleDef[]
}

/// Grup kurucusunun tanımladığı özel rol: isim + yetki bayrakları.
/// Kanvas ve bölge erişimleri bu role ayrı tablolarla (CanvasRoleAccess / RegionRoleAccess) bağlanır.
model GroupRoleDef {
  id                  String   @id @default(cuid())
  groupId             String
  group               Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name                String
  canManageMembers    Boolean  @default(false)
  canManageRoles      Boolean  @default(false)
  canCreateCanvas     Boolean  @default(true)
  /// Açık CanvasRoleAccess kaydı olmayan grup kanvasları için geçerli erişim: none | view | edit
  defaultCanvasAccess String   @default("edit")
  createdAt           DateTime @default(now())
  members             GroupMember[]
  canvasAccess        CanvasRoleAccess[]
  regionAccess        RegionRoleAccess[]

  @@index([groupId])
}

model GroupMember {
  groupId     String
  group       Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String        @default("member")
  status      String        @default("pending")
  jobTitle    String?
  roleDefId   String?
  roleDef     GroupRoleDef? @relation(fields: [roleDefId], references: [id], onDelete: SetNull)
  requestedAt DateTime      @default(now())

  @@id([groupId, userId])
}

/// Rolün belirli bir grup kanvasına erişimi: none | view | edit.
model CanvasRoleAccess {
  canvasId String
  canvas   Canvas       @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  roleId   String
  role     GroupRoleDef @relation(fields: [roleId], references: [id], onDelete: Cascade)
  access   String

  @@id([canvasId, roleId])
}

/// Rolün bölge üyeliği: kaydı olan rol o bölgedeki düğümlere dokunabilir.
model RegionRoleAccess {
  regionId String
  region   Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  roleId   String
  role     GroupRoleDef @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([regionId, roleId])
}

model GroupInvite {
  token     String   @id
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
}

model CanvasMember {
  canvasId String
  canvas   Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("editor")
  joinedAt DateTime @default(now())

  @@id([canvasId, userId])
}

model Region {
  id        String         @id @default(cuid())
  canvasId  String
  canvas    Canvas         @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  name      String
  x         Float
  y         Float
  width     Float
  height    Float
  color     String         @default("#d97757")
  description String        @default("")
  aiAllowed Boolean        @default(true)
  createdAt DateTime       @default(now())
  members   RegionMember[]
  roleAccess RegionRoleAccess[]

  @@index([canvasId])
}

model RegionMember {
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([regionId, userId])
}

model Invite {
  token     String   @id
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
}

model Node {
  canvasId      String
  canvas        Canvas  @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  id            String
  parentId      String?
  title         String
  description   String  @default("")
  nodeType      String  @default("task")
  status        String  @default("planned")
  x             Float?
  y             Float?
  /// Düğümün bağlı olduğu alt kanvas (aynı gruptaki bir Canvas id'si). Bilerek FK YOK:
  /// SetNull, Node'u commit dışında değiştirir ve rebuildCheck'i bozar; kanvas silinince
  /// sarkan bağlantı UI'da "erişilemiyor" olarak gösterilir.
  linkedCanvasId String?
  /// Serbest uzun not (markdown).
  notes         String  @default("")
  /// Düğüme iliştirilen harici bağlantı (yalnız http/https). Boş = yok.
  url           String  @default("")
  /// url'i son ayarlayan kullanıcı id'si; önizleme yalnız bu kişiye otomatik açılır (FK yok).
  urlBy         String?
  /// Serbest anahtar-değer özel alanlar. rowToNode/applyOp normalizeData ile kanonikleştirir,
  /// jsonb'nin anahtar sırası rebuildCheck'i etkilemez.
  data          Json    @default("{}")
  createdCommit Int
  updatedCommit Int

  @@id([canvasId, id])
}

model Edge {
  canvasId      String
  canvas        Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  id            String
  sourceId      String
  targetId      String
  kind          String @default("flow")
  direction     String @default("directed")
  label         String @default("")
  createdCommit Int

  @@id([canvasId, id])
}

model Commit {
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  seq       Int
  message   String
  createdAt DateTime @default(now())
  ops       String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@id([canvasId, seq])
  @@index([canvasId, branchId, seq])
}

model Branch {
  id        String   @id @default(cuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  name      String
  baseSeq   Int
  status    String   @default("open")
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  commits   Commit[]

  @@index([canvasId, status])
}

/// Co-Pronoia ajan rol tanımı: groupId null → site geneli şablon (admin yönetir);
/// dolu → gruba özel rol (canManageRoles yetkisiyle yönetilir). persona metni bağlanan
/// ajana get_brief aracıyla brifing olarak servis edilir.
model AgentRoleDef {
  id           String   @id @default(cuid())
  groupId      String?
  group        Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  persona      String   @default("")
  isSupervisor Boolean  @default(false)
  createdAt    DateTime @default(now())
  tokens       AgentToken[]
  tokenRoles   AgentTokenRole[]

  @@index([groupId])
}

/// Kanvas + role bağlı MCP ajan erişim anahtarı. Ham değer yalnızca oluşturma/yenileme
/// yanıtında döner; DB'de sha256 özeti durur (Session ham saklanır — burada bilinçli sapma: bu
/// uzun ömürlü, bir kez gösterilen bir API anahtarı; sha256 deterministik olduğundan lookup çalışır).
/// `roleId`/`role` VARSAYILAN (birincil) roldür — geriye dönük uyum ve tek-rollü token'ların
/// hâlâ çalışması için korunur. Çoklu rol `AgentTokenRole` join tablosuyla eklenir: mint sırasında
/// seçilen TÜM roller oraya da yazılır. Eski (bu özellikten önce basılmış) token'ların join
/// tablosunda hiç satırı olmaz — rol çözümlemesi (agentRoleService.rolesOf) bu durumda tek elemanlı
/// [role] listesine düşer, böylece elle bir taşıma betiği gerekmez (`prisma db push` yeterli).
model AgentToken {
  id          String       @id @default(cuid())
  tokenHash   String       @unique
  canvasId    String
  canvas      Canvas       @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  roleId      String
  role        AgentRoleDef @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roles       AgentTokenRole[]
  label       String
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  proposals   PlanProposal[]
  claims      NodeClaim[]

  @@index([canvasId])
}

/// Bir ajan anahtarının (tek MCP bağlantı) davranabildiği EK roller. `AgentToken.roleId`
/// birincil/varsayılan rolü tutar; bu tablo o kümeyi (birincil dahil) tam olarak yansıtır —
/// mint anında seçilen tüm roller buraya yazılır. Böylece tek bağlantı üzerinden birden çok
/// ajan rolü (ör. bir süpervizör + bir teknik ajan) çalışabilir.
model AgentTokenRole {
  tokenId String
  token   AgentToken   @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  roleId  String
  role    AgentRoleDef @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([tokenId, roleId])
}

/// Yumuşak claim/lease (pl1): bir ajanın bir bölgeyi ya da düğüm kümesini TTL boyunca geçici
/// olarak "üstlendiğini" ilan eden DANIŞMA kaydı. Kilit DEĞİL: commit yolu (opsConflict + branch)
/// hâlâ tek otoritedir; claim yalnız paralel ajanların aynı alana boşuna öneri üretmesini azaltır.
/// regionId'ye bilerek FK YOK (bölge silinse de kayıt sarkabilir, "silinmiş bölge" gösterilir);
/// süresi (expiresAt) geçen claim okurken süzülür ve ilk fırsatta silinir.
model NodeClaim {
  id        String     @id @default(cuid())
  canvasId  String
  canvas    Canvas     @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  tokenId   String
  token     AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  scope     String // 'region' | 'nodes'
  regionId  String? // scope='region' iken bölge id'si (FK yok — danışma)
  nodeIds   Json? // scope='nodes' iken string[] düğüm id'leri
  /// Claim anında DAVRANILAN rol adı (çok rollü token'da `role` parametresiyle seçilen rol);
  /// boş = bu alandan önce basılmış claim (okuma tarafı token'ın birincil rolüne düşer).
  roleName  String     @default("")
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([canvasId, expiresAt])
}

/// Ajan plan önerisi. intents: OpInput[] JSON'u (Commit.ops ile aynı desen: String alanda JSON).
/// agentLabel/roleName denormalize: token/rol silinse de öneri geçmişi okunur kalır.
/// status: submitted | changes_requested | withdrawn | rejected | applied (kodda doğrulanır).
model PlanProposal {
  id               String      @id @default(cuid())
  canvasId         String
  canvas           Canvas      @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  tokenId          String?
  token            AgentToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  agentLabel       String
  roleName         String
  title            String
  summary          String      @default("")
  intents          String
  baseSeq          Int
  status           String      @default("submitted")
  supervisorNote   String      @default("")
  decidedByLabel   String?
  appliedCommitSeq Int?
  branchName       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([canvasId, status])
}

/// Site geneli, adminin yönettiği görsel ayar (şu an tek anahtar: 'login_preview').
/// Ya yüklenen dosya (data+mimeType) ya da dış bir adres (url) tutulur; ikisi de boşsa
/// giriş ekranı paketle gelen örnek görseli gösterir. Kanvas verisiyle ilgisi yoktur.
model SiteAsset {
  key       String   @id
  mimeType  String?
  data      Bytes?
  url       String?
  updatedAt DateTime @updatedAt
}

// ---------- Yerel mod (APP_MODE=local) & bulut aktivasyonu ----------

/// YEREL kurulumda tek satır (id sabit 'singleton'): kurulumun bulut hesabıyla
/// eşleşmesi. Bekleyen aktivasyonda state/verifier doludur; tamamlanınca bulut
/// kimliği + instance token'ı kalıcı olarak burada durur (internet gerekmez).
model Activation {
  id            String   @id @default("singleton")
  state         String?
  verifier      String?
  cloudUserId   String?
  cloudUsername String?
  /// Bulutun verdiği `tmi_` anahtarı; yalnız yerel kurulumda ve ham saklanır
  /// (kendi makinesindeki DB'de; buluttaki karşılığı sha256'lı Instance satırıdır).
  instanceToken String?
  localUserId   String?
  activatedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// YEREL kurulumda: buluttan çekilmiş her kanvas bir kez alınır (tekrar çekmede atlanır).
model CloudImport {
  cloudCanvasId String   @id
  localCanvasId String
  name          String
  importedAt    DateTime @default(now())
}

/// YEREL tarafında: buluttaki bir grubun yerel karşılığı. `CloudImport`in grup eşi —
/// tekrar çekmede aynı grup ikinci kez kurulmasın ve kanvaslar doğru gruba (özellikle
/// co-pronoia gruplarına) insin diye. FK yok: kullanıcı yerel grubu silerse çekme
/// yeniden kurar, bulut tarafına dokunmaz.
model CloudGroupImport {
  cloudGroupId String   @id
  localGroupId String
  name         String
  importedAt   DateTime @default(now())
}

/// BULUT tarafında: bir yerel kurulumun aktivasyonu. Önce onay (state/codeHash/
/// proofHash/expiresAt), sonra exchange ile tek kullanımlık kod tüketilip kalıcı
/// instance token (sha256, AgentToken deseni) yazılır.
model Instance {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  state      String    @unique
  codeHash   String
  proofHash  String
  redirect   String
  expiresAt  DateTime
  usedAt     DateTime?
  tokenHash  String?   @unique
  label      String    @default("yerel kurulum")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
