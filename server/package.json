{
  "name": "@co-pronoia/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma db push && tsx watch src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "start": "prisma db push && tsx src/index.ts",
    "test": "vitest run",
    "prepare": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "bundle": "node build.mjs",
    "bundle:local": "node build.mjs --local",
    "start:bundle": "prisma db push && node dist/server.mjs"
  },
  "dependencies": {
    "@co-pronoia/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/oauth2": "^8.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "nanoid": "^5.0.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "prisma": "^7.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.21.0"
  }
}
