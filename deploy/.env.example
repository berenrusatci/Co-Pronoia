# `.env` olarak kopyalayın (aynı klasöre), sonra `docker compose up -d`.

# Yerel Postgres şifresi. İlk `up`tan sonra değiştirmek isterseniz hacmi de sıfırlamanız
# gerekir (`docker compose down -v` — TÜM yerel veriyi siler).
POSTGRES_PASSWORD=treemapper

# Hesap doğrulaması için bir kez konuşulacak bulut adresi. Aktivasyondan sonra
# internet gerekmez.
CLOUD_URL=https://co-pronoia.onrender.com

# Kurulumun tarayıcıdan görünen adresi. Boş bırakılırsa isteğin `Host` başlığından
# türetilir; vekil arkasında çalışıyorsanız buraya sabitleyin (bulut yalnızca yerel ağ
# adreslerine geri dönmeyi kabul eder: loopback / 192.168.x / 10.x / 172.16-31.x / *.local).
LOCAL_PUBLIC_ORIGIN=
